# Database: leave empty to use a local file in ./data, or point at Turso.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Copy this file to .env.local and fill in your key. Never commit .env.local.

# API key for any OpenAI-compatible AI service (used for receipt scanning and chat).
AI_API_KEY=

# Defaults target Google Gemini. Change these to use another provider.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL can list several models, comma-separated; the next is tried if one is busy.
# AI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest

# The admin: this email gets the admin panel at /admin. Creating the admin account
# also needs ADMIN_SETUP_CODE (required on Vercel), because emails are not verified.
# ADMIN_EMAIL=you@example.com
# ADMIN_SETUP_CODE=long-random-code

# Ads (optional). Without these the app shows no ads.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT=0000000000

# Copy this file to .env.local and fill in your key. Never commit .env.local.

# API key for any OpenAI-compatible AI service (used for receipt scanning and chat).
AI_API_KEY=

# Defaults target Google Gemini. Change these to use another provider.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL can list several models, comma-separated; the next is tried if one is busy.
# AI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest

# Only this email can create the account and log in. Set it before the app goes online,
# otherwise whoever registers first gets the account.
# OWNER_EMAIL=you@example.com
